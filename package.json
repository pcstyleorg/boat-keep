{
  "name": "boat-keep",
  "version": "0.2.0",
  "description": "Keep a boat.dev sandbox's running processes across fork, stop, reboot and resize (CRIU)",
  "type": "module",
  "bin": {
    "boat-keep": "boat-keep"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "boat-keep",
    "agent/",
    "dist/"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "boat",
    "boat.dev",
    "criu",
    "checkpoint-restore",
    "sandbox",
    "tmux",
    "cli"
  ],
  "homepage": "https://github.com/pcstyleorg/boat-keep#readme",
  "bugs": "https://github.com/pcstyleorg/boat-keep/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcstyleorg/boat-keep.git"
  },
  "license": "MIT",
  "author": "pc-style",
  "scripts": {
    "build": "bun build lib/index.ts --outdir dist --target node --packages external && bunx tsc -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@boatdev/sdk": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5"
  }
}
